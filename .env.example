# Required
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
SESSION_SECRET=replace-with-a-long-random-string

# Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production base URL (no trailing slash). Used to build OAuth callback URL.
# On Vercel preview/prod you can leave APP_URL unset and it'll fall back to VERCEL_URL.
# For local dev, set APP_URL=http://localhost:5000
APP_URL=http://localhost:5000

# Optional: local dev port (default 5000)
PORT=5000
